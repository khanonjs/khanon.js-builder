{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "importHelpers": true,
    "paths": {
      "@khanon-js-builder/contracts": ["libs/contracts/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
